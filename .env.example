APP_NAME=Url Shortener
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/url_shortener
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/url_shortener_test
DB_ECHO=false
# Empty = no cache. Docker compose sets redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=900
