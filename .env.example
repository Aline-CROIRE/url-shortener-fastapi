# Copy this file to .env and change the values for your machine.

# App info
APP_NAME=SnipBox
APP_VERSION=0.1.0

# "development" or "production"
ENVIRONMENT=development

# Turn debug off in production
DEBUG=true

# Public address of the app, used to build short links
BASE_URL=http://localhost:8000

# Redis connection address
REDIS_URL=redis://localhost:6379/0