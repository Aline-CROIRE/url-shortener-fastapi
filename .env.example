APP_NAME=Url Shortener
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
# Optional tracing (OpenTelemetry): where to send traces over OTLP/HTTP. Empty = off.
# Local Jaeger: docker compose --profile tracing up -d jaeger, then http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=url-shortener
# Share of traces kept (1.0 = all; e.g. 0.1 in a busy production)
OTEL_TRACES_SAMPLER_RATIO=1.0
# Optional: protects GET /metrics. Prometheus then sends "Authorization: Bearer <token>".
# Leave empty when /metrics is only reachable on an internal network
METRICS_TOKEN=
# json = one JSON object per line (production); text = easier to read by eye
LOG_FORMAT=json
BASE_URL=http://localhost:8000
# Other host names this shortener answers on (comma-separated); BASE_URL's host is
# always included. Short links may never point to them (they would loop)
OWN_HOSTS=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/url_shortener
# Optional read replica (docker compose --profile replica up -d db-replica). Empty = primary
DATABASE_REPLICA_URL=
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/url_shortener_test
DB_ECHO=false
# Redis DB 0 = redirect cache (+ rate-limit counters). Empty = no cache.
# Docker compose sets redis://redis:6379/0. Outside Docker use 127.0.0.1, NOT localhost:
# on Windows localhost tries IPv6 (::1) first, Docker only listens on IPv4, and every
# cache call then waits for its 0.5 s timeout (the cache looks "down")
REDIS_URL=redis://127.0.0.1:6379/0
# Longest time (seconds) a redirect stays cached; never longer than the link's expiry
CACHE_TTL_SECONDS=900
# Redis DB 1 = Celery's job queue (broker). Must differ from REDIS_URL's DB, so
# clearing the cache never deletes queued jobs. Docker compose sets redis://redis:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Optional: MaxMind GeoLite2-City file for click countries/cities (free MaxMind account).
# Empty = clicks are saved with an "Unknown" location. In Docker: put the file in ./geoip/
# and use GEOIP_DATABASE_PATH=/app/geoip/GeoLite2-City.mmdb
GEOIP_DATABASE_PATH=
# REQUIRED: signs the JWT access and refresh tokens. At least 32 characters, or the
# app refuses to start. Create your own random value (never commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Login attempts allowed per IP address ("5/minute", "20/hour", ...)
LOGIN_RATE_LIMIT=5/minute
# New accounts allowed per client (each one costs a slow password hash)
REGISTER_RATE_LIMIT=10/hour
# Short URLs one user may create (stops mass creation of spam or phishing links)
CREATE_URL_RATE_LIMIT=30/minute
# Failed logins allowed per account (email), from any address
LOGIN_ACCOUNT_RATE_LIMIT=10/hour
# Where rate-limit counters live. Empty = REDIS_URL (shared by all workers, kept across
# restarts), or memory:// without Redis. If Redis goes down, limits count in memory.
RATE_LIMIT_STORAGE_URI=
# Production behind a reverse proxy: the proxy's IP address(es), so Gunicorn trusts
# its X-Forwarded-For and rate limits see the real client IP (default 127.0.0.1)
# FORWARDED_ALLOW_IPS=10.0.0.5
# ---------- production sizing (Gunicorn; see app/core/capacity.py) ----------
# Gunicorn worker processes. Not set = 2 x CPU cores + 1
# WEB_CONCURRENCY=4
# Database connections per web worker: kept open + extra for busy moments
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# Seconds a request waits for a free pooled connection
DB_POOL_TIMEOUT=10
# PostgreSQL's max_connections (SHOW max_connections). Gunicorn refuses to start if
# WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) + Celery does not fit
DB_MAX_CONNECTIONS=100
# Threads per web worker for blocking calls (.delay(), metrics files); AnyIO's default
THREAD_POOL_SIZE=40
# Celery worker processes (celery-worker --concurrency)
CELERY_CONCURRENCY=2
