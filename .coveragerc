# Coverage settings for:  pytest --cov
[run]
# Measure our application code only (not the tests, not installed packages)
source = app
# Also check that both roads of every if/else were travelled
branch = True

[report]
# List the line numbers that no test ran
show_missing = True
skip_covered = True
# The coverage run FAILS if the total drops below this
fail_under = 98
# Lines that are deliberately not counted
exclude_also =
    # the "run as a script" guard: tested by calling main() directly
    if __name__ == .__main__.:
    # imports that exist only for type checkers, never at runtime
    if TYPE_CHECKING:
